<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN"
        "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="Menu">
        <folder name="Flutter">
            <attr name="displayName" stringvalue="Flutter"/>
            <attr name="position" intvalue="950"/>
        </folder>
    </folder>
    <folder name="Editors">
        <folder name="text">
            <folder name="x-dart">
                <attr name="displayName"
                      bundlevalue="dev.flutter.netbeans.plugin.Bundle#Editors/text/x-dart"/>
                <folder name="Preferences">
                    <folder name="Defaults">
                        <file name="DartPreferences.xml" url="dart/DartPreferences.xml"/>
                    </folder>
                </folder>
                <folder name="FontsColors">
                    <folder name="NetBeans">
                        <folder name="Defaults">
                            <file name="DartFontColors.xml" url="dart/DartFontColors.xml">
                                <attr name="SystemFileSystem.localizingBundle"
                                      stringvalue="dev.flutter.netbeans.plugin.Bundle"/>
                            </file>
                        </folder>
                    </folder>
                </folder>
            </folder>
        </folder>
    </folder>
    <folder name="OptionsDialog">
        <folder name="PreviewExamples">
            <folder name="text">
                <file name="x-dart" url="dart/DartExample.dart"/>
            </folder>
        </folder>
    </folder>
</filesystem>
